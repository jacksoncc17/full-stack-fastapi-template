# Production .env for the Docker Compose deployment.
# Copy to ../.env and fill in. NEVER commit the filled-in version.
#
# The app REFUSES TO START if SECRET_KEY, POSTGRES_PASSWORD or
# FIRST_SUPERUSER_PASSWORD is still "changethis" (see core/config.py:
# _enforce_non_default_secrets). Generate real values:
#
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"

# Leave UNSET in production. Setting it to "development" is what disables the
# default-secret check and enables dev-only routes.
# FASTAPI_ENV=development

PROJECT_NAME="Go Video Broker"

# --- required secrets (generate, do not reuse these) ---
SECRET_KEY=GENERATE_ME
POSTGRES_PASSWORD=GENERATE_ME
FIRST_SUPERUSER=you@example.com
FIRST_SUPERUSER_PASSWORD=GENERATE_ME

# --- the public hostname; Traefik gets a Let's Encrypt cert for it ---
DOMAIN=broker.example.com

# --- database: inside compose the host is the service name "db", NOT localhost ---
# This is the single most common compose mistake: copying the dev value leaves the
# backend looking for Postgres on itself.
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@db:5432/app

# --- CORS / redirects: must match the public URL exactly ---
FRONTEND_HOST=https://${DOMAIN}

# --- Google sign-in (optional; omit and the button is hidden) ---
# The redirect URI must be registered in Google Cloud Console EXACTLY as below.
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=https://${DOMAIN}/api/v1/auth/google/callback
FRONTEND_OAUTH_REDIRECT=https://${DOMAIN}/oauth/callback

# --- email (optional; without SMTP_HOST password reset is disabled) ---
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@example.com

# --- error reporting (optional) ---
SENTRY_DSN=
